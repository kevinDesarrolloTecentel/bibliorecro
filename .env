# API Principal del Backend (Servidor Laravel)
VITE_API_URL=https://bibliobackend.ccelrecreo.com:1500/server.php/api

# Servidor de Almacenamiento de Fotos
VITE_SERVER_URL=https://bibliobackend.ccelrecreo.com:1500/storage/app/public

# Servidor para descargar los reportes en Excel
VITE_SERVER_URL_REPORT=https://bibliobackend.ccelrecreo.com:1500/storage/app/public/reportes

# Clave Secreta para Encriptación Local de Tokens (CryptoJS)
VITE_ENCRYPTION_KEY=clave_token

# Habilitar Redux DevTools
VITE_REDUX_DEVTOOLS=true
